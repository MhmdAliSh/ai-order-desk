# Default: local deterministic extraction, no API key required.
AI_INTAKE_MODE=demo

# To use live OpenAI extraction, set AI_INTAKE_MODE=live and provide a key in
# your terminal environment. Do not add the real key to this file or Git.
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini
# DAILY_REPORT_AI_MODE=live

# Copy this file to .env for local development, then replace both passwords and
# the signing secret. The backend loads backend/.env automatically at startup.
ADMIN_EMAIL=owner@mobileandmore.demo
ADMIN_PASSWORD=replace-with-a-local-admin-password
STAFF_EMAIL=staff@mobileandmore.demo
STAFF_PASSWORD=replace-with-a-local-staff-password
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret

# WhatsApp Cloud API webhook connection (leave blank until Meta setup is ready).
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-random-verification-value
# WHATSAPP_APP_SECRET=from-meta-app-settings
# WHATSAPP_AUTO_REPLY_MODE=off
# WHATSAPP_ACCESS_TOKEN=from-meta-whatsapp-cloud-api
# WHATSAPP_PHONE_NUMBER_ID=from-meta-whatsapp-cloud-api
